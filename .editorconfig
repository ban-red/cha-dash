# https://editorconfig.org — what gofmt and the JavaScript linters expect.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[{go.mod,go.sum,go.work}]
indent_style = tab

# A trailing double space is a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# Recorded upstream responses stay byte-for-byte as captured.
[{testdata,**/testdata}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
