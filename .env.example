# Cha Dash · local spike credentials template. Copy to .env.local (git-ignored) and fill in.
# Proxmox VE: one block per instance listed in PVE_INSTANCES (UPPERCASE name in the keys).
# Use a privilege-separated API token with the PVEAuditor role for read-only spikes.
PVE_INSTANCES=example

PVE_EXAMPLE_URL=https://pve.example.lan:8006
PVE_EXAMPLE_TOKEN_ID=api@pam!chadash
PVE_EXAMPLE_TOKEN_SECRET=00000000-0000-0000-0000-000000000000

# Unraid (key via the ApiKeyAuthorize consent flow)
# UNRAID_JUPITER_URL=
# UNRAID_JUPITER_API_KEY=

# Node sandbox (spike 4.6)
# NODE_SANDBOX_HOST=
