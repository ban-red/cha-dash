{
  "name": "grid-compare-spike",
  "version": "0.0.0",
  "description": "Spike 2.4: our layout engine and Vue renderer against gridstack 14 and dnd-kit/dom on the same scenarios (ADR-0013).",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test && vitest run",
    "test:engine": "bun test",
    "test:vue": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "bench": "bun bench/timings.ts",
    "deps": "bun bench/deps.ts",
    "bundle": "bun bundle/build.ts",
    "page": "vite build --config page/vite.config.ts",
    "report": "bun report.ts"
  },
  "dependencies": {
    "@chadash/layout": "file:../../packages/layout",
    "@dnd-kit/dom": "0.5.0",
    "gridstack": "14.0.0",
    "motion-v": "2.5.2",
    "vue": "3.6.0-rc.10"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.14.5",
    "@types/bun": "^1.4.2",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "20.14.5",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  }
}
