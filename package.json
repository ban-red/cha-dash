{
  "name": "chadash",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "design/tokens",
    "tools/typecheck",
    "web"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:fresh": "bun scripts/dev.ts --fresh",
    "dev:real": "bun scripts/dev.ts --real",
    "build": "bun run --filter @chadash/web build",
    "test": "bun run --filter '*' test",
    "e2e": "bun run --filter @chadash/web e2e",
    "typecheck": "bun run --filter '*' typecheck",
    "typecheck:next": "bun run --filter @chadash/typecheck typecheck:next",
    "lint": "oxlint && bun --bun eslint . --cache",
    "lint:fix": "oxlint --fix && bun --bun eslint . --cache --fix",
    "check": "bun scripts/check.ts",
    "hooks": "git config core.hooksPath .githooks",
    "release:cut": "bun scripts/cut-release.ts",
    "release:check": "bun scripts/release-check.ts"
  },
  "devDependencies": {
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint": "10.13.0",
    "eslint-plugin-oxlint": "1.89.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "oxlint": "1.89.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
